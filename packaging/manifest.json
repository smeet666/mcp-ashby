{
  "manifest_version": "0.3",
  "name": "mcp-ashby",
  "display_name": "Ashby job boards",
  "version": "2.0.0",
  "description": "Search public Ashby job boards. No API key required.",
  "long_description": "Ashby hosts one job board per company and publishes no index across them, so every question starts with a company name. This server turns a name into the token that addresses its board, searches the openings of the companies you name, reads one posting in full, lists the wording each board uses, and puts published pay ranges side by side without converting between currencies. It says plainly what it could not find: a token that names nothing, a board publishing nothing, a posting recording no workplace, and a failed read are four different answers, and a company that withholds its pay ranges is never a salary of zero.",
  "author": {
    "name": "Damien Bouissou",
    "url": "https://github.com/smeet666"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smeet666/mcp-ashby.git"
  },
  "homepage": "https://github.com/smeet666/mcp-ashby#readme",
  "documentation": "https://github.com/smeet666/mcp-ashby#readme",
  "support": "https://github.com/smeet666/mcp-ashby/issues",
  "license": "MIT",
  "keywords": ["ashby", "jobs", "job-search", "ats", "hiring", "careers", "compensation"],
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.js"]
    }
  },
  "tools": [
    {
      "name": "resolve_board",
      "description": "Turn a company name into its Ashby board token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "A company name, or an Ashby board token you already know."
          }
        },
        "required": ["name"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      }
    },
    {
      "name": "search_jobs",
      "description": "Search the postings of named companies.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companies": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Company names or Ashby board tokens."
            },
            "description": "Company names or board tokens, one to 10. Each costs a request and a whole board, which is why 5 at a time is the comfortable number."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Words to look for."
          },
          "search_in": {
            "default": "title",
            "description": "Where query is looked for. Descriptions run to thousands of characters each.",
            "type": "string",
            "enum": ["title", "title_and_description"]
          },
          "department": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Departments as the board spells them."
                },
                "description": "A list of departments as the board spells them, one to 10 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Departments as the board spells them."
              }
            ]
          },
          "team": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Teams as the board spells them."
                },
                "description": "A list of teams as the board spells them, one to 10 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Teams as the board spells them."
              }
            ]
          },
          "employment_type": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Employment types."
                },
                "description": "A list of employment types, one to 6 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Employment types."
              }
            ]
          },
          "workplace_type": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Workplace types."
                },
                "description": "A list of workplace types, one to 4 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Workplace types."
              }
            ]
          },
          "is_remote": {
            "description": "Keeps only postings that declare it. Postings recording nothing are counted in undeclared rather than treated as on site.",
            "type": "boolean"
          },
          "country": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A country as the board spells it, as in USA or United Kingdom."
                },
                "description": "A list of countries as the board spells them, one to 10 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "A country as the board spells it, as in USA or United Kingdom."
              }
            ]
          },
          "location_contains": {
            "type": "string",
            "minLength": 1,
            "description": "Part of a location line."
          },
          "published_after": {
            "type": "string",
            "minLength": 1,
            "description": "An ISO 8601 date."
          },
          "has_compensation": {
            "description": "Keeps only postings whose company publishes a pay range.",
            "type": "boolean"
          },
          "salary_min": {
            "type": "number",
            "minimum": 0,
            "description": "A floor for the salary component."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "A three-letter currency code, as in EUR or USD."
          },
          "salary_interval": {
            "default": "1 YEAR",
            "description": "The period salary_min belongs to, 1 YEAR unless named. An hourly amount is never weighed against a yearly floor.",
            "type": "string",
            "minLength": 1
          },
          "sort": {
            "default": "published_desc",
            "type": "string",
            "enum": ["published_desc", "published_asc", "title"]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "How many postings to return."
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "How many postings to skip."
          }
        },
        "required": ["companies"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      }
    },
    {
      "name": "get_job",
      "description": "Read one posting in full.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "minLength": 1,
            "description": "A company name, or an Ashby board token."
          },
          "job_id": {
            "type": "string",
            "minLength": 1,
            "description": "The identifier search_jobs returned for this posting."
          },
          "description": {
            "default": "plain",
            "description": "The description runs to thousands of characters. html is the company's own markup, unrewritten.",
            "type": "string",
            "enum": ["plain", "html", "none"]
          },
          "include_compensation": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": ["board", "job_id"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      }
    },
    {
      "name": "list_filter_values",
      "description": "List the wording one board uses, and what it leaves unsaid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "minLength": 1,
            "description": "A company name, or an Ashby board token."
          },
          "facet": {
            "default": "all",
            "type": "string",
            "enum": [
              "departments",
              "teams",
              "locations",
              "countries",
              "employment_types",
              "workplace_types",
              "all"
            ]
          }
        },
        "required": ["board"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      }
    },
    {
      "name": "compare_compensation",
      "description": "Compare the pay ranges one board publishes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "minLength": 1,
            "description": "A company name, or an Ashby board token."
          },
          "job_ids": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Posting identifiers search_jobs returned."
            },
            "description": "A list of posting identifiers search_jobs returned, one to 50 of them."
          },
          "department": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Departments as the board spells them."
                },
                "description": "A list of departments as the board spells them, one to 10 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Departments as the board spells them."
              }
            ]
          },
          "team": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Teams as the board spells them."
                },
                "description": "A list of teams as the board spells them, one to 10 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Teams as the board spells them."
              }
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Words to look for in the titles."
          },
          "component": {
            "default": "Salary",
            "description": "One component at a time: a share of capital and a salary do not add up.",
            "type": "string",
            "enum": ["Salary", "EquityCashValue", "EquityPercentage", "Commission", "Bonus"]
          },
          "interval": {
            "default": "1 YEAR",
            "description": "The period compared, 1 YEAR unless named. Postings on another period are listed apart, unconverted.",
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "How many postings to compare."
          }
        },
        "required": ["board"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      }
    }
  ],
  "icon": "assets/icon-512.png",
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=24.0.0"
    }
  }
}
