    {
      "name": "list_filter_values",
      "title": "List a board's filter wordings",
      "description": "List the words one Ashby board actually uses, with how many postings carry each, and how many declare nothing. Every board keeps its own departments and teams, so a filter written from another board's vocabulary narrows to nothing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "minLength": 1,
            "description": "A company name, or an Ashby board token."
          },
          "facet": {
            "default": "all",
            "type": "string",
            "enum": [
              "departments",
              "teams",
              "locations",
              "countries",
              "employment_types",
              "workplace_types",
              "all"
            ]
          }
        },
        "required": ["board"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string"
          },
