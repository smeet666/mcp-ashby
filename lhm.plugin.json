{
  "author": "Damien Bouissou",
  "authorUrl": "https://github.com/smeet666",
  "description": "MCP server for public Ashby job boards. Resolve a company to its board, search its openings, read one posting and its pay. No API key required.",
  "homepage": "https://github.com/smeet666/mcp-ashby#readme",
  "identifier": "smeet666-mcp-ashby",
  "name": "mcp-ashby",
  "prompts": [],
  "resources": [],
  "tags": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ashby",
    "jobs",
    "job-search",
    "job-board",
    "ats",
    "hiring",
    "careers",
    "compensation",
    "no-api-key"
  ],
  "tools": [
    {
      "name": "resolve_board",
      "title": "Resolve company names to Ashby boards",
      "description": "Turn a company name into the token that addresses its Ashby job board, and report every form that answered. search_jobs does this on its own, so call this when a name returns nothing and you want to see the spellings that were tried.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "A company name, or an Ashby board token you already know."
          }
        },
        "required": ["name"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          },
          "found": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "board": {
                  "type": "string",
                  "description": "The token that answered. Ashby ignores case and echoes the spelling it was given, so this is no canonical spelling."
                },
                "job_count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "publishes": {
                  "type": "boolean",
                  "description": "False when the board exists and publishes nothing."
                }
              },
              "required": ["board", "job_count", "publishes"],
              "additionalProperties": false
            }
          },
          "tried": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The forms actually sent, in order."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["input", "found", "tried", "notes"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "search_jobs",
      "title": "Search postings at named companies",
      "description": "Search the open postings of named companies on Ashby. Ashby publishes no index across its customers, so companies are required. Every filter runs here rather than at the source, and the answer reports how many postings declared nothing about a field it filtered on. Rows carry no description: read one posting with get_job.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companies": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Company names or Ashby board tokens."
            },
            "description": "Company names or board tokens, one to 10. Each costs a request and a whole board, which is why 5 at a time is the comfortable number."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Words to look for."
          },
          "search_in": {
            "default": "title",
            "description": "Where query is looked for. Descriptions run to thousands of characters each.",
            "type": "string",
            "enum": ["title", "title_and_description"]
          },
          "department": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Departments as the board spells them."
                },
                "description": "A list of departments as the board spells them, one to 10 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Departments as the board spells them."
              }
            ]
          },
          "team": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Teams as the board spells them."
                },
                "description": "A list of teams as the board spells them, one to 10 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Teams as the board spells them."
              }
            ]
          },
          "employment_type": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Employment types."
                },
                "description": "A list of employment types, one to 6 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Employment types."
              }
            ]
          },
          "workplace_type": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Workplace types."
                },
                "description": "A list of workplace types, one to 4 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "Workplace types."
              }
            ]
          },
          "is_remote": {
            "description": "Keeps only postings that declare it. Postings recording nothing are counted in undeclared rather than treated as on site.",
            "type": "boolean"
          },
          "country": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A country as the board spells it, as in USA or United Kingdom."
                },
                "description": "A list of countries as the board spells them, one to 10 of them."
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "A country as the board spells it, as in USA or United Kingdom."
              }
            ]
          },
          "location_contains": {
            "type": "string",
            "minLength": 1,
            "description": "Part of a location line."
          },
          "published_after": {
            "type": "string",
            "minLength": 1,
            "description": "An ISO 8601 date."
          },
          "has_compensation": {
            "description": "Keeps only postings whose company publishes a pay range.",
            "type": "boolean"
          },
          "salary_min": {
            "type": "number",
            "minimum": 0,
            "description": "A floor for the salary component."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "A three-letter currency code, as in EUR or USD."
          },
          "salary_interval": {
            "default": "1 YEAR",
            "description": "The period salary_min belongs to, 1 YEAR unless named. An hourly amount is never weighed against a yearly floor.",
            "type": "string",
            "minLength": 1
          },
          "sort": {
            "default": "published_desc",
            "type": "string",
            "enum": ["published_desc", "published_asc", "title"]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "How many postings to return."
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "How many postings to skip."
          }
        },
        "required": ["companies"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total_on_board": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Postings the boards read hold, all of them."
          },
          "total_matched": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Postings the criteria kept."
          },
          "returned": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Postings in this answer, after limit and offset."
          },
          "jobs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "board": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "department": {
                  "type": "string"
                },
                "team": {
                  "type": "string"
                },
                "employment_type": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "country": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "secondary_location_count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "workplace_type": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Null when the company records none, which is never the same as on site."
                },
                "is_remote": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "is_listed": {
                  "type": "boolean",
                  "description": "False marks a posting Ashby serves by direct link alone rather than on the board."
                },
                "published_at": {
                  "type": "string",
                  "description": "ISO 8601 with the offset Ashby publishes."
                },
                "compensation_summary": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Null when the company withholds its pay ranges, which is never zero."
                },
                "job_url": {
                  "type": "string"
                },
                "apply_url": {
                  "type": "string"
                }
              },
              "required": [
                "board",
                "id",
                "title",
                "department",
                "team",
                "employment_type",
                "location",
                "country",
                "secondary_location_count",
                "workplace_type",
                "is_remote",
                "is_listed",
                "published_at",
                "compensation_summary",
                "job_url",
                "apply_url"
              ],
              "additionalProperties": false
            },
            "description": "No descriptions, at any limit."
          },
          "per_company": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "string"
                },
                "board": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": ["read", "unresolved", "empty", "failed"],
                  "description": "A company read, one whose token was not found, one publishing nothing and one that failed are four different answers."
                },
                "read": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Postings the board holds, before the filters applied here. Null when nothing was read, since zero would read as a board with nothing on it."
                },
                "matched": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Postings kept after them."
                },
                "error": {
                  "type": "string"
                }
              },
              "required": ["input", "board", "status", "read", "matched"],
              "additionalProperties": false
            }
          },
          "filters_applied": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "undeclared": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "description": "Postings a criterion could say nothing about, counted per field. A posting that records no workplace is not a posting on site."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "total_on_board",
          "total_matched",
          "returned",
          "jobs",
          "per_company",
          "filters_applied",
          "undeclared",
          "notes"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_job",
      "title": "Read one posting",
      "description": "Read one Ashby posting in full: its locations, its description and the pay ranges its company published. Ashby addresses a posting by board and identifier, both of which search_jobs returns.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "minLength": 1,
            "description": "A company name, or an Ashby board token."
          },
          "job_id": {
            "type": "string",
            "minLength": 1,
            "description": "The identifier search_jobs returned for this posting."
          },
          "description": {
            "default": "plain",
            "description": "The description runs to thousands of characters. html is the company's own markup, unrewritten.",
            "type": "string",
            "enum": ["plain", "html", "none"]
          },
          "include_compensation": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": ["board", "job_id"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "employment_type": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "The location as the company wrote it, free text with no taxonomy."
              },
              "locality": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "region": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "country": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "As the board publishes it, European Union included. No country code, and never corrected: one board writes USA where another writes United States."
              }
            },
            "required": ["label", "locality", "region", "country"],
            "additionalProperties": false
          },
          "workplace_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the company records none, which is never the same as on site."
          },
          "is_remote": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_listed": {
            "type": "boolean",
            "description": "False marks a posting Ashby serves by direct link alone rather than on the board."
          },
          "published_at": {
            "type": "string",
            "description": "ISO 8601 with the offset Ashby publishes."
          },
          "compensation_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the company withholds its pay ranges, which is never zero."
          },
          "job_url": {
            "type": "string"
          },
          "apply_url": {
            "type": "string"
          },
          "secondary_locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "description": "The location as the company wrote it, free text with no taxonomy."
                },
                "locality": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "region": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
